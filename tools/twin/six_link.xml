<!-- SA3 (SO-ARM101 validation plan): repository-owned PRIMITIVE six-joint
     fixture. Only the joint-axis TOPOLOGY follows the SO-ARM101 pattern
     (base pan Z / shoulder lift Y / elbow Y / wrist flex Y / wrist roll Z /
     gripper X); geometry, masses and limits are primitive placeholders.
     This file claims NO vendor fidelity: a community SO-ARM101 MJCF can be
     substituted at runtime via the loader's local-path model flag
     (repository discipline: vendor models are never vendored, KB-093). -->
<mujoco model="plcopen_sa3_six_link">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast"/>
  <default>
    <joint type="hinge" limited="true" range="-1.9 1.9" damping="1" armature="0.01"/>
    <geom type="capsule" size="0.02" density="600" rgba="0.82 0.55 0.22 1"/>
    <position kp="80" ctrllimited="true" ctrlrange="-1.9 1.9"/>
  </default>
  <worldbody>
    <body name="base">
      <geom type="cylinder" size="0.06 0.03" rgba="0.28 0.22 0.18 1"/>
      <body name="link1" pos="0 0 0.06">
        <joint name="joint1" axis="0 0 1"/>
        <geom fromto="0 0 0 0 0 0.05"/>
        <body name="link2" pos="0 0 0.05">
          <joint name="joint2" axis="0 1 0"/>
          <geom fromto="0 0 0 0 0 0.11" rgba="0.88 0.65 0.25 1"/>
          <body name="link3" pos="0 0 0.11">
            <joint name="joint3" axis="0 1 0"/>
            <geom fromto="0 0 0 0 0 0.13"/>
            <body name="link4" pos="0 0 0.13">
              <joint name="joint4" axis="0 1 0"/>
              <geom fromto="0 0 0 0 0 0.06" rgba="0.88 0.65 0.25 1"/>
              <body name="link5" pos="0 0 0.06">
                <joint name="joint5" axis="0 0 1"/>
                <geom fromto="0 0 0 0 0 0.05"/>
                <body name="link6" pos="0 0 0.05">
                  <joint name="joint6" axis="1 0 0"/>
                  <geom fromto="0 0 0 0 0 0.05" rgba="0.88 0.65 0.25 1"/>
                  <site name="tool" pos="0 0 0.05" size="0.03"
                        rgba="0.15 0.55 0.95 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="actuator1" joint="joint1"/>
    <position name="actuator2" joint="joint2"/>
    <position name="actuator3" joint="joint3"/>
    <position name="actuator4" joint="joint4"/>
    <position name="actuator5" joint="joint5"/>
    <position name="actuator6" joint="joint6"/>
  </actuator>
</mujoco>
